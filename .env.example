# Copy this file to `.env` and fill in the values. Never commit the real .env.
# No spaces around "=" and no trailing spaces after a value.

# --- required ---
POSTGRES_PASSWORD=change-me-to-a-strong-password
# long random string used to sign login tokens; the app refuses to start without it
# generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# --- which LLM answers questions: gemini | claude | ollama ---
LLM_BACKEND=gemini

# if LLM_BACKEND=gemini (comma-separated: tried in order, with retries and fallback)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# if LLM_BACKEND=claude
ANTHROPIC_API_KEY=your-anthropic-api-key
# CLAUDE_MODEL=claude-haiku-5-5

# if LLM_BACKEND=ollama (Ollama running on your host machine, reached from inside Docker)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
